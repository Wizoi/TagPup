# Virtual environments
.venv/

# Local data files and cache directories
data/

# This installation's settings, which the app writes to. The template is config.example.ini.
config.ini

# Python compilation and cache files
__pycache__/
*.py[cod]
*$py.class
suggestions.json

# ExifTool backups
*_original

# Server log files
*.log

# Frontend test tooling (dev only; the apps ship no JS dependencies)
node_modules/
package-lock.json

# Database backups
backups/

# Each test file's last time, kept by tools/run_tests.py
tests/.durations.json

# Where this machine keeps each library's roots (tagpup.config.machine_roots_path): per machine
machine_roots.json
.claude/worktrees/
